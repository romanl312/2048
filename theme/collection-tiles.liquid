{%- liquid
  assign style = section.settings.style
-%}
<section
  class="tiles tiles--{{ style }} color-{{ section.settings.color_scheme }} section"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; --tile-cols: {{ section.settings.columns }};"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-head">
        <h2 class="h2 section-head__title">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.link != blank and section.settings.link_label != blank -%}
          <a href="{{ section.settings.link }}" class="section-head__link">{{ section.settings.link_label | escape }}{%- render 'icon', name: 'arrow-right' -%}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="tiles__list" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign label = block.settings.label | default: c.title
          assign url = block.settings.link | default: c.url
          assign image = block.settings.image
          if image == blank and block.settings.product != blank
            assign image = block.settings.product.featured_image
          endif
          if image == blank and c != blank
            assign image = c.featured_image
          endif
          if c == blank and block.settings.link == blank
            assign url = routes.all_products_collection_url
          endif
          assign tile_alt = label | escape
        -%}
        <li class="tiles__item" {{ block.shopify_attributes }}>
          <a href="{{ url }}" class="tile">
            <span class="tile__media">
              {%- if image != blank -%}
                {{ image | image_url: width: 700 | image_tag:
                  widths: '240, 360, 480, 600, 700',
                  sizes: '(min-width: 990px) 20vw, (min-width: 750px) 30vw, 45vw',
                  loading: 'lazy',
                  alt: tile_alt
                }}
              {%- else -%}
                <span class="tile__placeholder">{%- render 'icon', name: block.settings.icon -%}</span>
              {%- endif -%}
            </span>
            <span class="tile__label">
              <span>{{ label | escape }}</span>
              {%- render 'icon', name: 'arrow-right', class: 'icon tile__arrow' -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .tiles .tiles__list {
    display: grid; gap: 12px; list-style: none; margin: 0; padding: 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 750px) { .tiles .tiles__list { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; } }
  @media (min-width: 990px) { .tiles .tiles__list { grid-template-columns: repeat(var(--tile-cols, 5), minmax(0, 1fr)); } }
  .tiles .tile {
    display: flex; flex-direction: column; height: 100%;
    border-radius: var(--radius); overflow: hidden;
    background: rgb(var(--c-surface)); text-decoration: none;
    box-shadow: 0 6px 22px rgba(14, 36, 56, .06);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .tiles .tile:hover { transform: translateY(-3px); box-shadow: 0 14px 30px rgba(14, 36, 56, .12); }
  .tiles .tile__media { position: relative; display: block; aspect-ratio: 4 / 3.4; overflow: hidden; background: rgba(var(--c-text), .04); }
  .tiles .tile__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .tiles .tile:hover .tile__media img { transform: scale(1.04); }
  .tiles .tile__placeholder { position: absolute; inset: 0; display: grid; place-items: center; color: rgb(var(--c-accent)); background: linear-gradient(135deg, rgba(var(--c-accent), .10), rgba(var(--c-accent), .20)); }
  .tiles .tile__placeholder .icon { width: 38%; height: 38%; stroke-width: 1.2; }
  .tiles .tile__label { flex: 1; background: #F2E7D9; display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 14px 16px; font-weight: 700; font-size: .95rem; }
  .tiles .tile__arrow { width: 18px; height: 18px; transition: transform .2s ease; }
  .tiles .tile:hover .tile__arrow { transform: translateX(3px); }

  /* Стиль «кружечки» для «Для кого» */
  .tiles--round .tile { background: none; box-shadow: none; align-items: center; text-align: center; }
  .tiles--round .tile:hover { box-shadow: none; }
  .tiles--round .tile__media { width: 100%; aspect-ratio: 1; border-radius: 50%; }
  .tiles--round .tile__label { background: none; justify-content: center; padding: 12px 4px 0; }
  .tiles--round .tile__arrow { display: none; }
  @media (max-width: 749px) {
    .tiles--round .tiles__list { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px 10px; }
    .tiles--round .tile__label { font-size: .82rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.collection_tiles",
  "tag": "div",
  "class": "section-tiles",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:settings.heading", "default": "Для якої компанії?" },
    { "type": "text", "id": "link_label", "label": "t:settings.link_label" },
    { "type": "url", "id": "link", "label": "t:settings.link" },
    {
      "type": "select", "id": "style", "label": "t:settings.tile_style",
      "options": [
        { "value": "card", "label": "t:options.tile_card" },
        { "value": "round", "label": "t:options.tile_round" }
      ],
      "default": "card"
    },
    { "type": "range", "id": "columns", "label": "t:settings.columns", "min": 3, "max": 6, "step": 1, "default": 5 },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:settings.color_scheme", "default": "scheme-1" },
    { "type": "header", "content": "t:settings.padding" },
    { "type": "range", "id": "padding_top", "label": "t:settings.padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "t:settings.padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "t:blocks.tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:settings.collection" },
        { "type": "text", "id": "label", "label": "t:settings.tile_label", "info": "t:settings.tile_label_info" },
        { "type": "image_picker", "id": "image", "label": "t:settings.image" },
        { "type": "product", "id": "product", "label": "t:settings.tile_product", "info": "t:settings.tile_product_info" },
        { "type": "url", "id": "link", "label": "t:settings.tile_link", "info": "t:settings.tile_link_info" },
        {
          "type": "select", "id": "icon", "label": "t:settings.placeholder_icon",
          "options": [
            { "value": "dice", "label": "t:options.icon_dice" },
            { "value": "users", "label": "t:options.icon_users" },
            { "value": "heart", "label": "t:options.icon_heart" },
            { "value": "gift", "label": "t:options.icon_gift" },
            { "value": "box", "label": "t:options.icon_box" },
            { "value": "star", "label": "t:options.icon_star" },
            { "value": "age", "label": "t:options.icon_age" },
            { "value": "album", "label": "t:options.icon_album" },
            { "value": "notebook", "label": "t:options.icon_notebook" },
            { "value": "planner", "label": "t:options.icon_planner" },
            { "value": "journal", "label": "t:options.icon_journal" },
            { "value": "postcard", "label": "t:options.icon_postcard" },
            { "value": "sticker", "label": "t:options.icon_sticker" }
          ],
          "default": "dice"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.collection_tiles",
      "blocks": [
        { "type": "tile", "settings": { "label": "Для компанії", "icon": "users" } },
        { "type": "tile", "settings": { "label": "Для сім'ї", "icon": "heart" } },
        { "type": "tile", "settings": { "label": "Для пари", "icon": "heart" } },
        { "type": "tile", "settings": { "label": "18+", "icon": "star" } },
        { "type": "tile", "settings": { "label": "Для дітей", "icon": "age" } }
      ]
    }
  ]
}
{% endschema %}
