{%- comment -%}
  Відгуки покупців (Judge.me). Віджет оживає, коли в «Вбудованих програмах» теми увімкнено Judge.me Core.
  Вміст product.metafields.judgeme.widget — збережена копія відгуків для швидкого показу й SEO.
{%- endcomment -%}
<section id="Reviews" class="product-reviews section color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width product-reviews__inner">
    {%- if section.settings.heading != blank -%}
      <div class="section-head">
        <h2 class="h2 section-head__title">{{ section.settings.heading | escape }}</h2>
        {%- render 'rating-stars', product: product, class: 'product-reviews__summary' -%}
      </div>
    {%- endif -%}
    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
    {%- endfor -%}
    {%- if section.blocks.size == 0 -%}
      <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget jdgm-outside-widget" data-id="{{ product.id }}" data-product-title="{{ product.title | escape }}" data-auto-install="false">{{ product.metafields.judgeme.widget }}</div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .product-reviews .product-reviews__inner { max-width: 980px; }
  .product-reviews .section-head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; }
  .product-reviews .jdgm-widget { font-family: var(--font-body); }
  .product-reviews .jdgm-rev-widg__title { display: none; }
  .product-reviews .jdgm-write-rev-link, .product-reviews .jdgm-btn {
    border-radius: 999px !important; background: rgb(var(--c-button)) !important; color: rgb(var(--c-button-label)) !important;
    border: 0 !important; padding: 12px 22px !important; font-weight: 700 !important;
  }
  .product-reviews .jdgm-star { color: #E0A21B !important; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_reviews",
  "tag": "div",
  "class": "section-product-reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:settings.heading", "default": "Відгуки покупців" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:settings.color_scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "t:settings.padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "t:settings.padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [{ "type": "@app" }],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "t:names.product_reviews" }]
}
{% endschema %}
