{%- comment -%}
  Рендериться лише через Section Rendering API: /search/suggest?section_id=predictive-search
{%- endcomment -%}
{%- if predictive_search.performed -%}
  <div class="ps">
    {%- if predictive_search.resources.products.size > 0 or predictive_search.resources.collections.size > 0 -%}
      {%- if predictive_search.resources.collections.size > 0 -%}
        <p class="ps__label">{{ 'general.search.collections' | t }}</p>
        <ul class="ps__chips" role="list">
          {%- for collection in predictive_search.resources.collections limit: 4 -%}
            <li><a href="{{ collection.url }}" class="ps__chip">{{ collection.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if predictive_search.resources.products.size > 0 -%}
        <p class="ps__label">{{ 'general.search.products' | t }}</p>
        <ul class="ps__list" role="listbox">
          {%- for product in predictive_search.resources.products limit: 6 -%}
            <li role="option">
              <a href="{{ product.url }}" class="ps__item">
                <span class="ps__img">
                  {%- if product.featured_image -%}
                    {{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', width: 56, height: 56, alt: '' }}
                  {%- endif -%}
                </span>
                <span class="ps__text">
                  <span class="ps__title">{%- render 'product-title', product: product -%}</span>
                  <span class="ps__price">{% if product.price == 0 and settings.coming_soon_text != blank %}{{ 'products.product.coming_soon' | t }}{% else %}{{ product.price | money }}{% unless product.available %} · {{ 'products.product.sold_out' | t }}{% endunless %}{% endif %}</span>
                </span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      <a href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}&options%5Bprefix%5D=last" class="ps__all">
        {{ 'general.search.view_all' | t: terms: predictive_search.terms }}
        {%- render 'icon', name: 'arrow-right' -%}
      </a>
    {%- else -%}
      <p class="ps__empty">{{ 'general.search.no_results' | t: terms: predictive_search.terms }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .ps { display: grid; gap: 6px; }
  .ps .ps__label { margin: 6px 8px 2px; font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: rgb(var(--c-muted)); }
  .ps .ps__chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 8px 4px; }
  .ps .ps__chip { display: inline-block; padding: 6px 12px; border-radius: 999px; background: rgba(var(--c-text), .06); text-decoration: none; font-size: .88rem; font-weight: 600; }
  .ps .ps__list { list-style: none; margin: 0; padding: 0; }
  .ps .ps__item { display: flex; align-items: center; gap: 12px; padding: 8px; border-radius: 10px; text-decoration: none; }
  .ps .ps__item:hover, .ps .ps__item:focus-visible { background: rgba(var(--c-text), .05); }
  .ps .ps__img { width: 56px; height: 56px; flex: none; border-radius: 8px; overflow: hidden; background: rgb(var(--c-surface)); }
  .ps .ps__img img { width: 100%; height: 100%; object-fit: contain; }
  .ps .ps__text { display: grid; gap: 2px; min-width: 0; }
  .ps .ps__title { font-weight: 600; font-size: .92rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ps .ps__price { font-size: .85rem; color: rgb(var(--c-accent)); font-weight: 700; }
  .ps .ps__all { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 10px; margin-top: 4px; border-top: 1px solid rgb(var(--c-border)); font-weight: 700; text-decoration: none; color: rgb(var(--c-accent)); }
  .ps .ps__all svg { width: 16px; height: 16px; }
  .ps .ps__empty { margin: 0; padding: 14px 10px; color: rgb(var(--c-muted)); }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.predictive_search",
  "settings": []
}
{% endschema %}
