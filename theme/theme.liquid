<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_schemes['scheme-1'].settings.background }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- comment -%} Системна колекція Shopify «Home page» (/collections/frontpage) — сюди потрапляють після входу в акаунт; ведемо на головну {%- endcomment -%}
    {%- if template.name == 'collection' and collection.handle == 'frontpage' -%}
      <meta name="robots" content="noindex">
      <script>window.location.replace({{ routes.root_url | json }});</script>
    {%- endif -%}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.pagination.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {%- render 'meta-tags' -%}
    {%- render 'theme-styles' -%}

    <link rel="stylesheet" href="{{ 'base.css' | asset_url }}">
    {%- if template.name == 'product' -%}
      <link rel="stylesheet" href="{{ 'template-product.css' | asset_url }}">
    {%- endif -%}
    {%- if template.name == 'collection' or template.name == 'search' -%}
      <link rel="stylesheet" href="{{ 'template-collection.css' | asset_url }}">
    {%- endif -%}

    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          search: {{ routes.search_url | json }}
        },
        cartType: {{ settings.cart_type | json }},
        strings: {
          added: {{ 'products.product.added' | t | json }},
          error: {{ 'general.error' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }}
        }
      };
    </script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}--{{ template.suffix }}{% endif %} color-scheme-1">
    <a class="skip-link visually-hidden-focusable" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' -%}
      {%- render 'cart-drawer' -%}
    {%- endif -%}

    <div class="toast" id="Toast" role="status" aria-live="polite" hidden></div>
  </body>
</html>
